{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swadamfoods-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swadam_orders",
      "database_id": "f1ddcf6c-0825-431b-8994-e7497c3350b3"
    }
  ]
}
