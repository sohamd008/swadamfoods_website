{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swadam Foods Product Catalog",
  "type": "object",
  "required": ["name", "version", "products"],
  "properties": {
    "name": {"type":"string"},
    "version": {"type":"string"},
    "products": {
      "type":"array",
      "items": {
        "type":"object",
        "required":["id","name","weight","price","currency","availability"],
        "properties": {
          "id":{"type":"string"},
          "name":{"type":"string"},
          "weight":{"type":"string"},
          "price":{"type":"number"},
          "currency":{"type":"string"},
          "availability":{"type":"string"},
          "preparation":{"type":"string"}
        }
      }
    },
    "order":{"type":"string"}
  }
}
