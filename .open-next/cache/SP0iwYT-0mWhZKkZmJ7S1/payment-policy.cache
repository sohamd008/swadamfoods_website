r-white/60 dark:border-white/10\",\"children\":[[\"$\",\"$Le\",null,{\"href\":\"/\",\"className\":\"inline-flex items-center gap-2 text-sm font-bold text-muted-foreground transition-colors hover:text-primary\",\"children\":[[\"$\",\"$Lf\",null,{\"ref\":\"$undefined\",\"icon\":{\"name\":\"arrow-left\",\"size\":24,\"node\":[[\"path\",{\"d\":\"m12 19-7-7 7-7\",\"key\":\"1l729n\"}],[\"path\",{\"d\":\"M19 12H5\",\"key\":\"x3x0zl\"}]]},\"className\":\"h-4 w-4\",\"aria-hidden\":\"true\"}],\"Back to home\"]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 text-balance font-heading text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl\",\"children\":\"Payments & Payment Security\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground\",\"children\":[\"Last updated: \",\"8 September 2026\"]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Swadam Foods uses third-party payment service providers to process online payments securely. This policy explains how online payments work on our website and what you should expect when paying for an order.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8 flex flex-col gap-8 border-t border-border/60 pt-8\",\"children\":[[\"$\",\"section\",\"Payment Providers\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Payment Providers\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Online payments may be processed through PhonePe and, where used as an alternative payment provider, Razorpay. The payment provider available for a particular transaction may depend on system availability, transaction conditions and our checkout configuration.\"}],[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"The relevant payment provider may process payment and transaction information under its own terms and privacy notice in addition to our policies. PhonePe and Razorpay are independent payment service providers and are not the seller of Swadam Foods products.\"}]]]}],[\"$\",\"section\",\"What We Store\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"What We Store\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Swadam Foods stores order and payment-status information needed to fulfil and reconcile your purchase, such as order ID, transaction reference, selected payment provider, amount, status and relevant timestamps.\"}],[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"We do not store your full card number, CVV, UPI PIN, OTP, net-banking password or similar payment authentication secret in our website database. Do not send these credentials to us through WhatsApp, email, phone or any other channel.\"}]]]}],[\"$\",\"section\",\"Payment Status\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Payment Status\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"A payment can be successful, failed, expired or temporarily pending. Our server verifies payment status using information received from the payment provider rather than relying only on what the browser displays.\"}],\"$L10\"]]}],\"$L11\",\"$L12\",\"$L13\",\"$L14\",\"$L15\"]}]]}]}]}],[\"$L16\"],\"$L17\"]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L18\",null,{\"children\":\"$L19\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L1a\",null,{\"children\":[\"$\",\"$1b\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L1c\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\nd:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0byh0vdiv32ay.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n1d:I[97367,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"OutletBoundary\"]\na:C\n10:[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Please do not make another payment merely because the browser is slow or a payment page appears to be stuck. A second payment attempt is appropriate only after the first attempt is confirmed as unsuccessful or cancelled. This helps reduce duplicate charges.\"}]\n11:[\"$\",\"section\",\"Alternative Payment Provider\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Alternative Payment Provider\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Where the primary payment provider is clearly unavailable or an attempted transaction has definitively failed before completion, we may offer or use an alternate provider such as Razorpay. We do not treat an unknown or still-processing transaction as failed solely to start another payment attempt.\"}]]]}]\n12:[\"$\",\"section\",\"Payment Confirmation & Orders\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Payment Confirmation & Orders\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Your order is considered paid only after the transaction is successfully verified against the corresponding order. A payment page visit, browser redirect, screenshot or customer message is not by itself proof of successful payment.\"}],[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"If payment has succeeded but your order still appears pending, contact us with the order ID and payment transaction reference. We will reconcile the transaction with the relevant payment provider.\"}]]]}]\n13:[\"$\",\"section\",\"Refunds\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Refunds\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Approved refunds for online payments are generally initiated through the payment provider used for the original transaction and are normally returned to the original payment instrument, subject to the provider's capabilities, banking processes and applicable law. See our Refund & Cancellation Policy for eligibility and timing.\"}]]]}]\n14:[\"$\",\"section\",\"Payment Security\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Payment Security\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Payment credentials are handled by the applicable payment provider through its secure payment flow. Our gateway credentials and webhook verification secrets are kept on the server and are not intended to be exposed to customers or included in browser code.\"}],[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Swadam Foods will never ask for your UPI PIN, card PIN, CVV or OTP in order to confirm an order or issue a refund. If someone claiming to represent Swadam Foods requests such information, do not provide it.\"}]]]}]\n15:[\"$\",\"section\",\"Contact Information\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Contact Information\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"For payment questions or a payment reconciliation issue, contact Swadam Foods at swadamfoodsindia@gmail.com or +91 88888 51522. Please include the order ID and payment reference, but never include payment passwords, PINs, CVVs or OTPs.\"}]]]}]\n16:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3zjsxf0yaxvfu.js\",\"async\":true,\"nonce\":\"$undefined\"}]\n17:[\"$\",\"$L1d\",null,{\"children\":[\"$\",\"$1b\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@1e\"}]}]\n19:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"content\":\"#f7f2e7\",\"media\":\"(prefers-color-scheme: light)\"}],[\"$\",\"meta\",\"3\",{\"name\":\"theme-color\",\"content\":\"#25201a\",\"media\":\"(prefers-color-scheme: dark)\"}]]\n1f:I[27201,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"IconMark\"]\n1c:[[\"$\",\"title\",\"0\",{\"children\":\"Payments & Payment Security | Swadam Foods\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Payment methods, payment processing and payment-security information for Swadam Foods.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"keywords\",\"content\":\"Swadam Foods,Indian snacks,Patal Poha Chivda,Kanda Poha premix,Upma premix,instant breakfast,FSSAI\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://swadamfoods.eu.cc\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"Swadam Foods | Authentic Indian Snacks\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"Handcrafted Patal 