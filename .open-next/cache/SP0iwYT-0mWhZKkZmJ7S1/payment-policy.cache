\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"property\\\":\\\"og:locale\\\",\\\"content\\\":\\\"en_IN\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"9\\\",{\\\"property\\\":\\\"og:image\\\",\\\"content\\\":\\\"https://swadamfoods.eu.cc/images/swadam-logo.webp\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"10\\\",{\\\"property\\\":\\\"og:image:alt\\\",\\\"content\\\":\\\"Swadam Foods logo\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"11\\\",{\\\"property\\\":\\\"og:type\\\",\\\"content\\\":\\\"website\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"12\\\",{\\\"name\\\":\\\"twitter:card\\\",\\\"content\\\":\\\"summary_large_image\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"13\\\",{\\\"name\\\":\\\"twitter:title\\\",\\\"content\\\":\\\"Swadam Foods | Authentic Indian Snacks\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"14\\\",{\\\"name\\\":\\\"twitter:description\\\",\\\"content\\\":\\\"Handcrafted Patal Poha Chivda and instant Kanda Poha \\u0026 Upma premixes with secure online checkout.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"15\\\",{\\\"name\\\":\\\"twitter:image\\\",\\\"content\\\":\\\"https://swadamfoods.eu.cc/images/swadam-logo.webp\\\"}],[\\\"$\\\",\\\"link\\\",\\\"16\\\",{\\\"rel\\\":\\\"shortcut icon\\\",\\\"href\\\":\\\"/images/swadam-logo.webp\\\"}],[\\\"$\\\",\\\"link\\\",\\\"17\\\",{\\\"rel\\\":\\\"icon\\\",\\\"href\\\":\\\"/images/swadam-logo.webp\\\"}],[\\\"$\\\",\\\"link\\\",\\\"18\\\",{\\\"rel\\\":\\\"apple-touch-icon\\\",\\\"href\\\":\\\"/images/swadam-logo.webp\\\"}],[\\\"$\\\",\\\"$L1f\\\",\\\"19\\\",{}]]\\n1e:null\\n\"])</script></body></html>","rsc":"1:\"$Sreact.fragment\"\n2:I[79520,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"\"]\n3:I[89554,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"ThemeProvider\"]\n4:I[18376,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"CartProvider\"]\n5:I[39756,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"default\"]\n6:I[37457,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"default\"]\nc:I[68027,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"default\",1]\n:HL[\"/_next/static/chunks/0byh0vdiv32ay.css\