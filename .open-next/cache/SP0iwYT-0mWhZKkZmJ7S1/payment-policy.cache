yle\":{\"display\":\"inline-block\",\"margin\":\"0 20px 0 0\",\"padding\":\"0 23px 0 0\",\"fontSize\":24,\"fontWeight\":500,\"verticalAlign\":\"top\",\"lineHeight\":\"49px\"},\"children\":404}],[\"$\",\"div\",null,{\"style\":{\"display\":\"inline-block\"},\"children\":[\"$\",\"h2\",null,{\"style\":{\"fontSize\":14,\"fontWeight\":400,\"lineHeight\":\"49px\",\"margin\":0},\"children\":\"This page could not be found.\"}]}]]}]}]],[]]}]}]}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$7\"}}]]}]}]]}],\"isPartial\":\"$@8\",\"staleTime\":\"$9\",\"varyParams\":null}],\"isUpgradeableISRFallback\":false,\"a\":\"$@a\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@b\"}\n9:300\nb:true\n9:C\na:0\n8:\"$undefined\"\n","/payment-policy/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[22016,[\"/_next/static/chunks/1q1-17_3ay0jy.js\",\"/_next/static/chunks/3zjsxf0yaxvfu.js\"],\"\"]\n3:I[5014,[\"/_next/static/chunks/1q1-17_3ay0jy.js\",\"/_next/static/chunks/3zjsxf0yaxvfu.js\"],\"default\"]\nd:X\n12:X\n12:C\n0:{\"buildId\":\"SP0iwYT-0mWhZKkZmJ7S1\",\"data\":[{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"main\",null,{\"className\":\"ambient-bg min-h-dvh py-8 sm:py-12\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl px-4 sm:px-6\",\"children\":[\"$\",\"div\",null,{\"className\":\"glass-card rounded-[2.5rem] p-6 sm:p-10 shadow-xl border border-white/60 dark:border-white/10\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/\",\"className\":\"inline-flex items-center gap-2 text-sm font-bold text-muted-foreground transition-colors hover:text-primary\",\"children\":[[\"$\",\"$L3\",null,{\"icon\":{\"name\":\"arrow-left\",\"size\":24,\"node\":[[\"path\",{\"d\":\"m12 19-7-7 7-7\",\"key\":\"1l729n\"}],[\"path\",{\"d\":\"M19 12H5\",\"key\":\"x3x0zl\"}]]},\"className\":\"h-4 w-4\",\"aria-hidden\":\"true\"}],\"Back to home\"]}],[\"$\",\"h1\",null,{\"className\":\"mt-6 text-balance font-heading text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl\",\"children\":\"Payments & Payment Security\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground\",\"children\":[\"Last updated: \",\"8 September 2026\"]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Swadam Foods uses third-party payment service providers to process online payments securely. This policy explains how online payments work on our website and what you should expect when paying for an order.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8 flex flex-col gap-8 border-t border-border/60 pt-8\",\"children\":[[\"$\",\"section\",\"Payment Providers\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Payment Providers\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Online payments may be processed through PhonePe and, where used as an alternative payment provider, Razorpay. The payment provider available for a particular transaction may depend on system availability, transaction conditions and our checkout configuration.\"}],[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"The relevant payment provider may process payment and transaction information under its own terms and privacy notice in addition to our policies. PhonePe and Razorpay are independent payment service providers and are not the seller of Swadam Foods products.\"}]]]}],[\"$\",\"section\",\"What We Store\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"What We Store\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Swadam Foods stores order and payment-status information needed to fulfil and reconcile your purchase, such as order ID, transaction reference, selected payment provider, amount, status and relevant timestamps.\"}],[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"We do not store your full card number, CVV, UPI PIN, OTP, net-banking password or similar payment authentication secret in our website database. Do not send these credentials to us through WhatsApp, email, phone or any other channel.\"}]]]}],[\"$\",\"section\",\"Payment Status\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Payment Status\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"A payment can be successful, failed, expired or temporarily pending. Our server verifies payment status using information received from the payment provider rather than relying only on what the browser displays.\"}],\"$L4\"]]}],\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\"]}]]}]}]}],[\"$La\"],\"$Lb\"]}],\"isPartial\":\"$@c\",\"staleTime\":\"$d\",\"varyParams\":null},{\"rsc\":\"$Le\",\"isPartial\":\"$@f\",\"staleTime\":\"$d\",\"varyParams\":null},{\"rsc\":\"$L10\",\"isPartial\":\"$@11\",\"staleTime\":\"$d\",\"varyParams\":\"$12\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@13\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@14\"}\n15:I[97367,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"OutletBoundary\"]\n16:\"$Sreact.suspense\"\n18:I[97367,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"ViewportBoundary\"]\n19:I[97367,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"MetadataBoundary\"]\n1a:I[27201,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"IconMark\"]\n1b:I[39756,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"default\"]\n1c:I[37457,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"default\"]\n4:[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Please do not make another payment merely because the browser is slow or a payment page appears to be stuck. A second payment attempt is appropriate only after the first attempt is confirmed as unsuccessful or cancelled. This helps reduce duplicate charges.\"}]\n5:[\"$\",\"section\",\"Alternative Payment Provider\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Alternative Payment Provider\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Where the primary payment provider is clearly unavailable or an attempted transaction has definitively failed before completion, we may offer or use an alternate provider such as Razorpay. We do not treat an unknown or still-processing transaction as failed solely to start another payment attempt.\"}]]]}]\n6:[\"$\",\"section\",\"Payment Confirmation & Orders\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Payment Confirmation & Orders\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Your order is considered paid only after the transaction is successfully verified against the corresponding order. A payment page visit, browser redirect, screenshot or customer message is not by itself proof of successful payment.\"}],[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"If payment has succeeded but your order still appears pending, contact us with the order ID and payment transaction reference. We will reconcile the transaction with the relevant payment provider.\"}]]]}]\n7:[\"$\",\"section\",\"Refunds\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Refunds\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Approved refunds for online payments are generally initiated through the payment provider used for the original transaction and are normally returned to the original payment instrument, subject to the provider's capabilities, banking processes and applicable law. See our Refund & Cancellation Policy for eligibility and timing.\"}]]]}]\n8:[\"$\",\"section\",\"Payment Security\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Payment Security\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Payment credentials are handled by the applicable payment provider through its secure payment flow. Our gateway credentials and webhook verification secrets are kept on the server and are not intended to be exposed to customers or included in browser code.\"}],[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Swadam Foods will never ask for your UPI PIN, card PIN, CVV or OTP in order to confirm an order or issue a refund. If someone claiming to represent Swadam Foods requests such information, do not provide it.\"}]]]}]\n9:[\"$\",\"section\",\"Contact Information\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Contact Information\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"For payment questions or a payment reconciliation issue, contact Swadam Foods at swadamfoodsindia@gmail.com or +91 88888 51522. Please include the order ID and payment reference, but never include payment passwords, PINs, CVVs or OTPs.\"}]]]}]\na:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3zjsxf0yaxvfu.js\",\"async\":true}]\nb:[\"$\",\"$L15\",null,{\"children\":[\"$\",\"$16\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@17\"}]}]\ne:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L18\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"content\":\"#f7f2e7\",\"media\":\"(prefers-color-scheme: light)\"}],[\"$\",\"meta\",\"3\",{\"name\":\"theme-color\",\"content\":\"#25201a\",\"media\":\"(prefers-color-scheme: dark)\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L19\",null,{\"children\":[\"$\",\"$16\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"Payments & Payment Security | Swadam Foods\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Payment methods, payment processing and payment-security information for Swadam Foods.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"keywords\",\"content\":\"Swadam Foods,Indian snacks,Patal Poha Chivda,Kanda Poha premix,Upma premix,instant breakfast,FSSAI\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://swadamfoods.eu.cc\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"Swadam Foods | Authentic Indian Snacks\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"Handcrafted Patal Poha Chivda and instant Kanda Poha & Upma premixes with secure online checkout.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://swadamfoods.eu.cc\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:site_name\",\"content\":\"Swadam Foods\"}],[\"$\",\"meta\",\"8\",