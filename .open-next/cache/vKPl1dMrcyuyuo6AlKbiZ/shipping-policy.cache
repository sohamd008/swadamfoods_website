851522\",\"priceRange\":\"₹₹\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Lane No. 30/31 B, Ganesh Nagar, Dhayari\",\"addressLocality\":\"Pune\",\"addressRegion\":\"Maharashtra\",\"addressCountry\":\"IN\"},\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Snacks & Instant Premixes\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Patal Poha Chivda\",\"description\":\"Thin, crisp flattened rice tossed with roasted peanuts, curry leaves and a delicate turmeric-spice blend. A light, moreish tea-time snack made the traditional way.\",\"image\":\"https://swadamfoods.eu.cc/images/patal-poha-chivda.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":90,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Instant Kanda Poha Premix\",\"description\":\"Everything you need for authentic Kanda Poha in one pack. Just add hot water, rest, and enjoy a soft, fragrant breakfast with onions, chilies and turmeric.\",\"image\":\"https://swadamfoods.eu.cc/images/kanda-poha.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":70,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Instant Upma Premix\",\"description\":\"A savoury semolina premix with curry leaves, mustard and chilies. Add hot water for a warm, comforting upma anytime of the day.\",\"image\":\"https://swadamfoods.eu.cc/images/upma.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":70,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}}]}},{\"@type\":\"FAQPage\",\"@id\":\"https://swadamfoods.eu.cc/#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What products does Swadam Foods sell?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We sell Patal Poha Chivda (200 g, ₹90), Instant Kanda Poha Premix (150 g, ₹70), and Instant Upma Premix (150 g, ₹70).\"}},{\"@type\":\"Question\",\"name\":\"How do I prepare the Instant Kanda Poha Premix?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Empty the premix into a bowl, add hot boiling water equal to half the amount of premix (1 part water to 2 parts premix), cover and rest for 5 minutes.\"}},{\"@type\":\"Question\",\"name\":\"How do I prepare the Instant Upma Premix?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Empty the premix into a bowl, add hot boiling water equal to the same amount as the premix (1:1 ratio), cover and rest for 5 minutes.\"}},{\"@type\":\"Question\",\"name\":\"How do I order from Swadam Foods?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Add products to the cart on our website, then check out via WhatsApp. We confirm the order and arrange delivery.\"}},{\"@type\":\"Question\",\"name\":\"Is Swadam Foods a registered business?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, we are FSSAI registered and UDYAM MSME registered. We are a women-owned business based in Pune, Maharashtra.\"}}]}]}a:X\n0:{\"P\":null,\"c\":[\"\",\"shipping-policy\"],\"q\":\"\",\"i\":false,\"f\":[[[\"\",{\"children\":[\"shipping-policy\",{\"children\":[\"__PAGE__\",{},\"$undefined\",\"$undefined\",4608]},\"$undefined\",\"$undefined\",4608]},\"$undefined\",\"$undefined\",4624],[[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/1lyrdxijtqets.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/1q1-17_3ay0jy.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"suppressHydrationWarning\":true,\"className\":\"bg-background cormorant_garamond_e7b997e7-module__ClGyWq__variable\"