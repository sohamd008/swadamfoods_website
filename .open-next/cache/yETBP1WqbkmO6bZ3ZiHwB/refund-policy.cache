ren\":[[\"$\",\"main\",null,{\"className\":\"min-h-dvh bg-background\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20\",\"children\":[[\"$\",\"$L2\",null,{\"href\":\"/\",\"className\":\"inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-primary\",\"children\":[[\"$\",\"$L3\",null,{\"icon\":{\"name\":\"arrow-left\",\"size\":24,\"node\":[[\"path\",{\"d\":\"m12 19-7-7 7-7\",\"key\":\"1l729n\"}],[\"path\",{\"d\":\"M19 12H5\",\"key\":\"x3x0zl\"}]]},\"className\":\"h-4 w-4\",\"aria-hidden\":\"true\"}],\"Back to home\"]}],[\"$\",\"h1\",null,{\"className\":\"mt-8 text-balance font-heading text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl\",\"children\":\"Refund & Cancellation Policy\"}],[\"$\",\"p\",null,{\"className\":\"mt-2 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground\",\"children\":[\"Last updated: \",\"8 September 2026\"]}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-pretty leading-relaxed text-muted-foreground\",\"children\":\"This refund and cancellation policy outlines how you can cancel or seek a refund for a product or service that you have purchased through the Platform. All cancellation, refund and replacement requests are subject to review and approval by Swadam Foods.\"}],[\"$\",\"div\",null,{\"className\":\"mt-10 flex flex-col gap-8\",\"children\":[[\"$\",\"section\",\"Cancellation\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Cancellation\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Cancellations will only be considered if the request is made within 7 days of placing the order and will be subject to approval by Swadam Foods. However, cancellation requests may not be entertained if the order has been communicated for shipping, the shipping process has been initiated, or the product is out for delivery. In such an event, you may choose to reject the product at the doorstep, subject to applicable policy and delivery conditions.\"}],[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"Swadam Foods does not accept cancellation requests for perishable items like eatables. However, a refund or replacement may be considered if the customer establishes that the quality of the product delivered is not good, and any refund or replacement will be subject to approval by Swadam Foods.\"}]]]}],[\"$\",\"section\",\"Damaged or Defective Products\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Damaged or Defective Products\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"In case of receipt of damaged or defective items, please report the issue to our customer service team. The request will be entertained once the product has been checked and the same is determined by us. Any refund, replacement or exchange arising from such a request will be subject to approval by Swadam Foods. This should be reported within 7 days of receipt of products.\"}],[\"$\",\"p\",\"1\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"If you feel that the product received is not as shown on the site or is not as per your expectations, you must bring it to the notice of our customer service within 7 days of receiving the product. Our customer service team, after looking into your complaint, will take an appropriate decision. Any refund, replacement or exchange will be subject to approval by Swadam Foods.\"}]]]}],\"$L4\",\"$L5\",\"$L6\"]}]]}]}],[\"$L7\"],\"$L8\"]}],\"isPartial\":\"$@9\",\"staleTime\":\"$a\",\"varyParams\":null},{\"rsc\":\"$Lb\",\"isPartial\":\"$@c\",\"staleTime\":\"$a\",\"varyParams\":null},{\"rsc\":\"$Ld\",\"isPartial\":\"$@e\",\"staleTime\":\"$a\",\"varyParams\":\"$f\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@10\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@11\"}\n12:I[97367,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"OutletBoundary\"]\n13:\"$Sreact.suspense\"\n15:I[97367,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"ViewportBoundary\"]\n16:I[97367,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"MetadataBoundary\"]\n17:I[27201,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"IconMark\"]\n18:I[39756,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"default\"]\n19:I[37457,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"default\"]\n4:[\"$\",\"section\",\"Manufacturer Warranty\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Manufacturer Warranty\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"In case of complaints regarding products that come with a warranty from the manufacturers, please refer the issue to the manufacturer concerned.\"}]]]}]\n5:[\"$\",\"section\",\"Refund Processing\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Refund Processing\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"No refund is automatic or guaranteed merely because a request is submitted. In case any refund is approved by Swadam Foods following review of the request, it will take 5 days for the refund to be processed.\"}]]]}]\n6:[\"$\",\"section\",\"Contact Information\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Contact Information\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"For cancellation or refund requests, please contact Swadam Foods at swadamfoodsindia@gmail.com / +91 88888 51522.\"}]]]}]\n7:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/3zjsxf0yaxvfu.js\",\"async\":true}]\n8:[\"$\",\"$L12\",null,{\"children\":[\"$\",\"$13\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@14\"}]}]\nb:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L15\",null,{\"children\":[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"2\",{\"name\":\"theme-color\",\"content\":\"#f7f2e7\",\"media\":\"(prefers-color-scheme: light)\"}],[\"$\",\"meta\",\"3\",{\"name\":\"theme-color\",\"content\":\"#25201a\",\"media\":\"(prefers-color-scheme: dark)\"}]]}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L16\",null,{\"children\":[\"$\",\"$13\",null,{\"name\":\"Next.Metadata\",\"children\":[[\"$\",\"title\",\"0\",{\"children\":\"Refund & Cancellation Policy | Swadam Foods\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Cancellation and refund policy for Swadam Foods orders.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"keywords\",\"content\":\"Swadam Foods,Indian snacks,Patal Poha Chivda,Kanda Poha premix,Upma premix,instant breakfast,FSSAI\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://swadamfoods.eu.cc\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"Swadam Foods | Authentic Indian Snacks\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"Handcrafted Patal Poha Chivda and instant Kanda Poha & Upma premixes with secure online checkout.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://swadamfoods.eu.cc\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:site_name\",\"content\":\"Swadam Fo