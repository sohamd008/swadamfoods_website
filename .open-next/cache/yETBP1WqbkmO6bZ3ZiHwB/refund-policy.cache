{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/refund-policy/layout,_N_T_/refund-policy/page,_N_T_/refund-policy"},"segmentPaths":["/_tree","/_full","/_index","/refund-policy/__PAGE__"],"prefetchHints":{"hints":0,"slots":{"children":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"bg-background manrope_9b24f49e-module__hJlnFq__variable\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/a343f882a40d2cc9-s.p.1sj6eobyi31rd.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2yyif39t0l3_h.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0jvhpaew_uadu.js\"/><script src=\"/_next/static/chunks/24uyhvvmdi5sa.js\" async=\"\"></script><script src=\"/_next/static/chunks/33wmmxu2kkyqh.js\" async=\"\"></script><script src=\"/_next/static/chunks/458li-alk1r9y.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-45883o6xne8qs.js\" async=\"\"></script><script src=\"/_next/static/chunks/1q1-17_3ay0jy.js\" async=\"\"></script><script src=\"/_next/static/chunks/3zjsxf0yaxvfu.js\" async=\"\"></script><meta name=\"theme-color\" content=\"#f7f2e7\" media=\"(prefers-color-scheme: light)\"/><meta name=\"theme-color\" content=\"#25201a\" media=\"(prefers-color-scheme: dark)\"/><title>Refund &amp; Cancellation Policy | Swadam Foods</title><meta name=\"description\" content=\"Cancellation and refund policy for Swadam Foods orders.\"/><meta name=\"keywords\" content=\"Swadam Foods,Indian snacks,Patal Poha Chivda,Kanda Poha premix,Upma premix,instant breakfast,FSSAI\"/><link rel=\"canonical\" href=\"https://swadamfoods.eu.cc\"/><meta property=\"og:title\" content=\"Swadam Foods | Authentic Indian Snacks\"/><meta property=\"og:description\" content=\"Handcrafted Patal Poha Chivda and instant Kanda Poha &amp; Upma premixes with secure online checkout.\"/><meta property=\"og:url\" content=\"https://swadamfoods.eu.cc\"/><meta property=\"og:site_name\" content=\"Swadam Foods\"/><meta property=\"og:locale\" content=\"en_IN\"/><meta property=\"og:image\" content=\"https://swadamfoods.eu.cc/images/swadam-logo.webp\"/><meta property=\"og:image:alt\" content=\"Swadam Foods logo\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Swadam Foods | Authentic Indian Snacks\"/><meta name=\"twitter:description\" content=\"Handcrafted Patal Poha Chivda and instant Kanda Poha &amp; Upma premixes with secure online checkout.\"/><meta name=\"twitter:image\" content=\"https://swadamfoods.eu.cc/images/swadam-logo.webp\"/><link rel=\"shortcut icon\" href=\"/images/swadam-logo.webp\"/><link rel=\"icon\" href=\"/images/swadam-logo.webp\"/><link rel=\"apple-touch-icon\" href=\"/images/swadam-logo.webp\"/><meta name=\"next-size-adjust\" content=\"\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"font-sans antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><script>((a,b,c,d,e,f,g,h)=>{let i=document.documentElement,j=[\"light\",\"dark\"];function k(b){var c;(Array.isArray(a)?a:[a]).forEach(a=>{let c=\"class\"===a,d=c&&f?e.map(a=>f[a]||a):e;c?(i.classList.remove(...d),i.classList.add(f&&f[b]?f[b]:b)):i.setAttribute(a,b)}),c=b,h&&j.includes(c)&&(i.style.colorScheme=c)}if(d)k(d);else try{let a=localStorage.getItem(b)||c,d=g&&\"system\"===a?window.matchMedia(\"(prefers-color-scheme: dark)\").matches?\"dark\":\"light\":a;k(d)}catch(a){}})(\"class\",\"theme\",\"light\",null,[\"light\",\"dark\"],null,true,true)</script><main class=\"min-h-dvh bg-background\"><div class=\"mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20\"><a class=\"inline-flex items-center gap-2 text-sm font-medium text-muted-foreground transition-colors hover:text-primary\" href=\"/\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-left h-4 w-4\" aria-hidden=\"true\"><path d=\"m12 19-7-7 7-7\"></path><path d=\"M19 12H5\"></path></svg>Back to home</a><h1 class=\"mt-8 text-balance font-heading text-3xl font-extrabold tracking-tight text-foreground sm:text-4xl\">Refund &amp; Cancellation Policy</h1><p class=\"mt-2 text-xs font-semibold uppercase tracking-[0.16em] text-muted-foreground\">Last updated: <!-- -->8 September 2026</p><p class=\"mt-4 text-pretty leading-relaxed text-muted-foreground\">This refund and cancellation policy outlines how you can cancel or seek a refund for a product or service that you have purchased through the Platform. All cancellation, refund and replacement requests are subject to review and approval by Swadam Foods.</p><div class=\"mt-10 flex flex-col gap-8\"><section class=\"flex flex-col gap-3\"><h2 class=\"font-heading text-xl font-bold text-foreground\">Cancellation</h2><p class=\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\">Cancellations will only be considered if the request is made within 7 days of placing the order and will be subject to approval by Swadam Foods. However, cancellation requests may not be entertained if the order has been communicated for shipping, the shipping process has been initiated, or the product is out for delivery. In such an event, you may choose to reject the product at the doorstep, subject to applicable policy and delivery conditions.</p><p class=\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\">Swadam Foods does not accept cancellation requests for perishable items like eatables. However, a refund or replacement may be considered if the customer establishes that the quality of the product delivered is not good, and any refund or replacement will be subject to approval by Swadam Foods.</p></section><section class=\"flex flex-col gap-3\"><h2 class=\"font-heading text-xl font-bold text-foreground\">Damaged or Defective Products</h2><p class=\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\">In case of receipt of damaged or defective items, please report the issue to our customer service team. The request will be entertained once the product has been checked and the same is determined by us. Any refund, replacement or exchange arising from such a request will be subject to approval by Swadam Foods. This should be reported within 7 days of receipt of products.</p><p class=\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\">If you feel that the product received is not as shown on the site or is not as per your expectations, you must bring it to the notice of our customer service within 7 days of receiving the product. Our customer service team, after looking into your complaint, will take an appropriate decision. Any refund, replacement or exchange will be subject to approval by Swadam Foods.</p></section><section class=\"flex flex-col gap-3\"><h2 class=\"font-heading text-xl font-bold text-foreground\">Manufacturer Warranty</h2><p class=\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\">In case of complaints regarding products that come with a warranty from the manufacturers, please refer the issue to the manufacturer concerned.</p></section><section class=\"flex flex-col gap-3\"><h2 class=\"font-heading text-xl font-bold text-foreground\">Refund Processing</h2><p class=\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\">No refund is automatic or guaranteed merely because a request is submitted. In case any refund is approved by Swadam Foods following review of the request, it will take 5 days for the refund to be processed.</p></section><section class=\"flex flex-col gap-3\"><h2 class=\"font-heading text-xl font-bold text-foreground\">Contact Information</h2><p class=\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\">For cancellation or refund requests, please contact Swadam Foods at swadamfoodsindia@gmail.com / +91 88888 51522.</p></section></div></div></main><!--$--><!--/$--><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"name\":\"Swadam Foods\",\"url\":\"https://swadamfoods.eu.cc\",\"logo\":\"https://swadamfoods.eu.cc/images/swadam-logo.webp\",\"email\":\"swadamfoodsindia@gmail.com\",\"telephone\":\"+918888851522\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Lane No. 30/31 B, Ganesh Nagar, Dhayari\",\"addressLocality\":\"Pune\",\"addressRegion\":\"Maharashtra\",\"addressCountry\":\"IN\"},\"sameAs\":[\"https://www.instagram.com/swadamfoodsindia\"]},{\"@type\":\"LocalBusiness\",\"@id\":\"https://swadamfoods.eu.cc/#business\",\"name\":\"Swadam Foods\",\"image\":\"https://swadamfoods.eu.cc/images/swadam-logo.webp\",\"url\":\"https://swadamfoods.eu.cc\",\"telephone\":\"+918888851522\",\"priceRange\":\"₹₹\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Lane No. 30/31 B, Ganesh Nagar, Dhayari\",\"addressLocality\":\"Pune\",\"addressRegion\":\"Maharashtra\",\"addressCountry\":\"IN\"},\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Snacks & Instant Premixes\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Patal Poha Chivda\",\"description\":\"Thin, crisp flattened rice tossed with roasted peanuts, curry leaves and a delicate turmeric-spice blend. A light, moreish tea-time snack made the traditional way.\",\"image\":\"https://swadamfoods.eu.cc/images/patal-poha-chivda.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":90,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Instant Kanda Poha Premix\",\"description\":\"Everything you need for authentic Kanda Poha in one pack. Just add hot water, rest, and enjoy a soft, fragrant breakfast with onions, chilies and turmeric.\",\"image\":\"https://swadamfoods.eu.cc/images/kanda-poha.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":70,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Instant Upma Premix\",\"description\":\"A savoury semolina premix with curry leaves, mustard and chilies. Add hot water for a warm, comforting upma anytime of the day.\",\"image\":\"https://swadamfoods.eu.cc/images/upma.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":70,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}}]}},{\"@type\":\"FAQPage\",\"@id\":\"https://swadamfoods.eu.cc/#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What products does Swadam Foods sell?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We sell Patal Poha Chivda (200 g, ₹90), Instant Kanda Poha Premix (150 g, ₹70), and Instant Upma Premix (150 g, ₹70).\"}},{\"@type\":\"Question\",\"name\":\"How do I prepare the Instant Kanda Poha Premix?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Empty the premix into a bowl, add hot boiling water equal to half the amount of premix (1 part water to 2 parts premix), cover and rest for 5 minutes.\"}},{\"@type\":\"Question\",\"name\":\"How do I prepare the Instant Upma Premix?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Empty the premix into a bowl, add hot boiling water equal to the same amount as the premix (1:1 ratio), cover and rest for 5 minutes.\"}},{\"@type\":\"Question\",\"name\":\"How do I order from Swadam Foods?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Add products to the cart, complete the checkout form, and pay securely online. Payment is processed by PhonePe or, where used as an alternative, Razorpay. For help with an order, contact us on WhatsApp.\"}},{\"@type\":\"Question\",\"name\":\"Is Swadam Foods a registered business?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, we are FSSAI registered and UDYAM MSME registered. We are a women-owned business based in Pune, Maharashtra.\"}}]}]}</script><script src=\"/_next/static/chunks/0jvhpaew_uadu.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[79520,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"\\\"]\\n3:I[89554,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"ThemeProvider\\\"]\\n4:I[18376,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"CartProvider\\\"]\\n5:I[39756,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"default\\\"]\\n6:I[37457,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"default\\\"]\\nc:I[68027,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/2yyif39t0l3_h.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/a343f882a40d2cc9-s.p.1sj6eobyi31rd.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n7:Te96,{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@graph\\\":[{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Swadam Foods\\\",\\\"url\\\":\\\"https://swadamfoods.eu.cc\\\",\\\"logo\\\":\\\"https://swadamfoods.eu.cc/images/swadam-logo.webp\\\",\\\"email\\\":\\\"swadamfoodsindia@gmail.com\\\",\\\"telephone\\\":\\\"+918888851522\\\",\\\"address\\\":{\\\"@type\\\":\\\"PostalAddress\\\",\\\"streetAddress\\\":\\\"Lane No. 30/31 B, Ganesh Nagar, Dhayari\\\",\\\"addressLocality\\\":\\\"Pune\\\",\\\"addressRegion\\\":\\\"Maharashtra\\\",\\\"addressCountry\\\":\\\"IN\\\"},\\\"sameAs\\\":[\\\"https:/