l font-bold text-foreground\",\"children\":\"Exempt Products\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"There may be certain categories of products / items that are exempted from returns or refunds. Such categories will be identified to you at the time of purchase. Any applicable return, exchange, replacement or refund remains subject to approval by Swadam Foods.\"}]]]}],[\"$\",\"section\",\"Inspection & Processing\",{\"className\":\"flex flex-col gap-3\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-heading text-xl font-bold text-foreground\",\"children\":\"Inspection & Processing\"}],[[\"$\",\"p\",\"0\",{\"className\":\"whitespace-pre-line text-pretty leading-relaxed text-muted-foreground\",\"children\":\"For an accepted exchange / return request, once the returned product / item is received and inspected by us, we will notify you about receipt of the returned / exchanged product. If the request is approved after our quality check, the return or exchange will be processed in accordance with our policies. Approval of the request is at the discretion of Swadam Foods, subject to applicable law.\"}]]]}],[\"$\",\"section\",\"Contact Information\",{\"className\":\"flex flex-col gap-3\",\"children\":[\"$L4\",[\"$L5\"]]}]]}]]}]}],[\"$L6\"],\"$L7\"]}],\"isPartial\":\"$@8\",\"staleTime\":\"$9\",\"varyParams\":null},{\"rsc\":\"$La\",\"isPartial\":\"$@b\",\"staleTime\":\"$9\",\"varyParams\":null},{\"rsc\":\"$Lc\",\"isPartial\":\"$@d\",\"staleTime\":\"$9\",\"varyParams\":\"$e\"}],\"isUpgradeableISRFallback\":false,\"a\":\"$@f\",\"rootVaryParams\":null,\"needsRuntimeRequest\":\"$@10\"}\n11:I[97367,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"OutletBoundary\"]\n12:\"$Sreact.suspense\"\n14:I[97367,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"ViewportBoundary\"]\n15:I[97367,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"MetadataBoundary\"]\n16:I[27201,[\"/_next/static/chunks/1q1-17_3ay0j