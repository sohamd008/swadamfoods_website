font-bold text-muted-foreground transition-colors hover:text-primary\" href=\"/cookie-policy\">Cookies</a></nav></div></div></div></footer><!--$--><!--/$--><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"name\":\"Swadam Foods\",\"url\":\"https://swadamfoods.eu.cc\",\"logo\":\"https://swadamfoods.eu.cc/images/swadam-logo.webp\",\"email\":\"swadamfoodsindia@gmail.com\",\"telephone\":\"+918888851522\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Lane No. 30/31 B, Ganesh Nagar, Dhayari\",\"addressLocality\":\"Pune\",\"addressRegion\":\"Maharashtra\",\"addressCountry\":\"IN\"},\"sameAs\":[\"https://www.instagram.com/swadamfoodsindia\"]},{\"@type\":\"LocalBusiness\",\"@id\":\"https://swadamfoods.eu.cc/#business\",\"name\":\"Swadam Foods\",\"image\":\"https://swadamfoods.eu.cc/images/swadam-logo.webp\",\"url\":\"https://swadamfoods.eu.cc\",\"telephone\":\"+918888851522\",\"priceRange\":\"₹₹\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Lane No. 30/31 B, Ganesh Nagar, Dhayari\",\"addressLocality\":\"Pune\",\"addressRegion\":\"Maharashtra\",\"addressCountry\":\"IN\"},\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Snacks & Instant Premixes\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Patal Poha Chivda\",\"description\":\"Thin, crisp flattened rice tossed with roasted peanuts, curry leaves and a delicate turmeric-spice blend. A light, moreish tea-time snack made the traditional way.\",\"image\":\"https://swadamfoods.eu.cc/images/patal-poha-chivda.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":90,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Instant Kanda Poha Premix\",\"description\":\"Everything you need for authentic Kanda Poha in one pack. Just add hot water, rest, and enjoy a soft, fragrant breakfast with onions, chilies and turmeric.\",\"image\":\"https://swadamfoods.eu.cc/images/kanda-poha.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":70,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Instant Upma Premix\",\"description\":\"A savoury semolina premix with curry leaves, mustard and chilies. Add hot water for a warm, comforting upma anytime of the day.\",\"image\":\"https://swadamfoods.eu.cc/images/upma.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":70,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}}]}},{\"@type\":\"FAQPage\",\"@id\":\"https://swadamfoods.eu.cc/#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What products does Swadam Foods sell?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We sell Patal Poha Chivda (200 g, ₹90), Instant Kanda Poha Premix (150 g, ₹70), and Instant Upma Premix (150 g, ₹70).\"}},{\"@type\":\"Question\",\"name\":\"How do I prepare the Instant Kanda Poha Premix?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Empty the premix into a bowl, add hot boiling water equal to half the amount of premix (1 part water to 2 parts premix), cover and rest for 5 minutes.\"}},{\"@type\":\"Question\",\"name\":\"How do I prepare the Instant Upma Premix?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Empty the premix into a bowl, add hot boiling water equal to the same amount as the premix (1:1 ratio), cover and rest for 5 minutes.\"}},{\"@type\":\"Question\",\"name\":\"How do I order from Swadam Foods?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Add products to the cart, complete the checkout form, and pay securely online. Payment is processed by PhonePe or, where used as an alternative, Razorpay. For help with an order, contact us on WhatsApp.\"}},{\"@type\":\"Question\",\"name\":\"Is Swadam Foods a registered business?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, we are FSSAI registered and UDYAM MSME registered. We are a women-owned business based in Pune, Maharashtra.\"}}]}]}</script><script src=\"/_next/static/chunks/0jvhpaew_uadu.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[79520,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"\\\"]\\n3:I[89554,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"ThemeProvider\\\"]\\n4:I[18376,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"CartProvider\\\"]\\n5:I[39756,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"default\\\"]\\n6:I[37457,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"default\\\"]\\na:I[68027,[\\\"/_next/static/chunks/1q1-17_3ay0jy.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/2pvf7d8pj3_8o.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/a343f882a40d2cc9-s.p.1sj6eobyi31rd.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n7:Te96,{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@graph\\\":[{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Swadam Foods\\\",\\\"url\\\":\\\"https://swadamfoods.eu.cc\\\",\\\"logo\\\":\\\"https://swadamfoods.eu.cc/images/swadam-logo.webp\\\",\\\"email\\\":\\\"swadamfoodsindia@gmail.com\\\",\\\"telephone\\\":\\\"+918888851522\\\",\\\"address\\\":{\\\"@type\\\":\\\"PostalAddress\\\",\\\"streetAddress\\\":\\\"Lane No. 30/31 B, Ganesh Nagar, Dhayari\\\",\\\"addressLocality\\\":\\\"Pune\\\",\\\"addressRegion\\\":\\\"Maharashtra\\\",\\\"addressCountry\\\":\\\"IN\\\"},\\\"sameAs\\\":[\\\"https://www.instagram.com/swadamfoodsindia\\\"]},{\\\"@type\\\":\\\"LocalBusiness\\\",\\\"@id\\\":\\\"https://swadamfoods.eu.cc/#business\\\",\\\"name\\\":\\\"Swadam Foods\\\",\\\"image\\\":\\\"https://swadamfoods.eu.