[79520,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"\"]\n3:I[89554,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"ThemeProvider\"]\n4:I[18376,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"CartProvider\"]\n5:I[39756,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"default\"]\n6:I[37457,[\"/_next/static/chunks/1q1-17_3ay0jy.js\"],\"default\"]\n:HL[\"/_next/static/chunks/2pvf7d8pj3_8o.css\",\"style\"]\n7:Te96,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"name\":\"Swadam Foods\",\"url\":\"https://swadamfoods.eu.cc\",\"logo\":\"https://swadamfoods.eu.cc/images/swadam-logo.webp\",\"email\":\"swadamfoodsindia@gmail.com\",\"telephone\":\"+918888851522\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Lane No. 30/31 B, Ganesh Nagar, Dhayari\",\"addressLocality\":\"Pune\",\"addressRegion\":\"Maharashtra\",\"addressCountry\":\"IN\"},\"sameAs\":[\"https://www.instagram.com/swadamfoodsindia\"]},{\"@type\":\"LocalBusiness\",\"@id\":\"https://swadamfoods.eu.cc/#business\",\"name\":\"Swadam Foods\",\"image\":\"https://swadamfoods.eu.cc/images/swadam-logo.webp\",\"url\":\"https://swadamfoods.eu.cc\",\"telephone\":\"+918888851522\",\"priceRange\":\"₹₹\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"Lane No. 30/31 B, Ganesh Nagar, Dhayari\",\"addressLocality\":\"Pune\",\"addressRegion\":\"Maharashtra\",\"addressCountry\":\"IN\"},\"hasOfferCatalog\":{\"@type\":\"OfferCatalog\",\"name\":\"Snacks & Instant Premixes\",\"itemListElement\":[{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Patal Poha Chivda\",\"description\":\"Thin, crisp flattened rice tossed with roasted peanuts, curry leaves and a delicate turmeric-spice blend. A light, moreish tea-time snack made the traditional way.\",\"image\":\"https://swadamfoods.eu.cc/images/patal-poha-chivda.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":90,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Instant Kanda Poha Premix\",\"description\":\"Everything you need for authentic Kanda Poha in one pack. Just add hot water, rest, and enjoy a soft, fragrant breakfast with onions, chilies and turmeric.\",\"image\":\"https://swadamfoods.eu.cc/images/kanda-poha.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":70,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}},{\"@type\":\"Offer\",\"itemOffered\":{\"@type\":\"Product\",\"name\":\"Instant Upma Premix\",\"description\":\"A savoury semolina premix with curry leaves, mustard and chilies. Add hot water for a warm, comforting upma anytime of the day.\",\"image\":\"https://swadamfoods.eu.cc/images/upma.webp\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Swadam Foods\"},\"offers\":{\"@type\":\"Offer\",\"price\":70,\"priceCurrency\":\"INR\",\"availability\":\"https://schema.org/InStock\"}}}]}},{\"@type\":\"FAQPage\",\"@id\":\"https://swadamfoods.eu.cc/#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What products does Swadam Foods sell?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We sell Patal Poha Chivda (200 g, ₹90), Instant Kanda Poha Premix (150 g, ₹70), and Instant Upma Premix (150 g, ₹70).\"}},{\"@type\":\"Question\",\"name\":\"How do I prepare the Instant Kanda Poha Premix?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Empty the premix into a bowl, add hot boiling water equal to half the amount of premix (1 part water to 2 parts premix), cover and rest for 5 minutes.\"}},{\"@type\":\"Question\",\"name\":\"How do I prepare the Instant Upma Premix?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Empty the premix into a bowl, add hot boiling water equal to the same amount as the premix (1:1 ratio), cover and rest for 5 minutes.\"}},{\"@type\":\"Question\",\"name\":\"How do I order from Swadam Foods?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Add products to the cart, complete the checkout form, and pay securely online. Payment is processed by PhonePe or, where used as an alternative, Razorpay. For help with an order, contact us on WhatsApp.\"}},{\"@type\":\"Question\",\"name\":\"Is Swadam Foods a registered business?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, we are FSSAI registered and UDYAM MSME registered. We are a women-owned business based in Pune, Maharashtra.\"}}]}]}9:X\n0:{\"buildId\":\"rF-Pyovk2soueyGkyAIG3\",\"data\":[{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/2pvf7d8pj3_8o.css\",\"precedence\":\"next\"}],[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/1q1-17_3ay0jy.js\",\"async\":true}]],[\"$\",\"html\",null,{\"lang\":\"en\",\"suppressHydrationWarning\":true,\"className\":\"bg-background manrope_9b24f49e-module__hJlnFq__variable\",\"children\":[\"$\",\"body\",null,{\"className\":\"font-sans antialiased\",\"suppressHydrationWarning\":true,\"children\":[[\"$\",\"$L2\",null,{\"src\":\"https://www.googletagmanager.com/gtag/js?id=G-9MMSSWSXB0\",\"strategy\":\"lazyOnload\"}],[\"$\",\"$L2\",null,{\"id\":\"google-analytics\",\"strategy\":\"afterInteractive\",\"children\":\"window.dataLayer = window.dataLayer || [];\\nfunction gtag(){dataLayer.push(arguments);}\\ngtag('js', new Date());\\ngtag('config', 'G-9MMSSWSXB0', { send_page_view: true });\"}],[\"$\",\"$L3\",null,{\"attribute\":\"class\",\"defaultTheme\":\"light\",\"enableSystem\":true,\"disableTransitionOnChange\":true,\"children\":[\"$\",\"$L4\",null,{\"children\":[\"$\",\"$L5\",null,{\"parallelRouterKey\":\"children\",\"template\":[\"$\",\"$L6\",null,{}],\"notFound\":[[[\"$\",\"title\",null,{\"children\":\"404: This page could not be found.\"}],[\"$\",\"div\",null,{\"style\":{\"fontFamily\":\"system-ui,\\\"Segoe UI\\\",Roboto,Helvetica,Arial,sans-serif,\\\"Apple Color Emoji\\\",\\\"Segoe UI Emoji\